<!DOCTYPE HTML>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Foreman documentation: <%= @item[:title] %></title>
    <% latest_stable_version = releases_in_state('supported').first[:version] %>
    <% if @item[:state] && @item[:state] != 'nightly' && @item[:version] != latest_stable_version %>
    <meta name="robots" content="noindex">
    <% end %>
    <link rel="stylesheet" href="/css/default.css">
    <meta name="generator" content="Nanoc <%= Nanoc::VERSION %>">
  </head>
  <body>
  <%= render "/nav.html.erb" %>
  <div class="container narrow">
  <%= yield %>
  </div>
  </body>
</html>
