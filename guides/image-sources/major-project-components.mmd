---
config:
    theme: default
---
architecture-beta

    group server(mdi:server)[Foreman server]
        service provisioning(mdi:hammer-wrench)[Provisioning] in server
        service config(mdi:cog)[Configuration management] in server
        service content(mdi:package-variant-closed)[Content management] in server
        service auth(mdi:shield-lock)[Authentication] in server
        service built-in-proxy(mdi:server)[Built-in Smart Proxy] in server

    provisioning:R -- L:config
    config:R -- L:content
    content:R -- L:auth
    auth:R -- L:built-in-proxy

    service proxy1(mdi:server)[Smart Proxy 1]
    service proxy2(mdi:server)[Smart Proxy 2]

    service hosts1(mdi:monitor)[Hosts]

    service hosts2(mdi:monitor)[Hosts]

    service hosts3(mdi:monitor)[Hosts]

    junction j-out
    junction j-top
    junction j-bottom
    junction j-no-proxy

    content{group}:B -- T:j-out
    j-out:R -- L:j-top
    j-out:L -- R:j-bottom

    j-top:B --> T:proxy1
    j-out:B --> T:proxy2
    j-bottom:B -- T:j-no-proxy

    proxy1:B --> T:hosts1
    proxy2:B --> T:hosts2
    j-no-proxy:B --> T:hosts3
